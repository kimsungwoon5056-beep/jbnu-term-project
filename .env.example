# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱의 firebaseConfig 값을 복사해
# 이 파일을 .env.local로 복사한 뒤 채운다. .env.local은 저장소에 올라가지 않는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 실시간 대결용 Realtime Database 주소(콘솔 > Realtime Database 데이터 탭 맨 위)
VITE_FIREBASE_DATABASE_URL=
