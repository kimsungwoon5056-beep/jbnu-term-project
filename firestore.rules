rules_version = '2';

// 하루 기록은 users/{uid}/records/{YYYY-MM-DD}에 둔다.
// 앱의 src/records/record.js 규칙(validateRecord, checkDateWindow)과 같은 내용을 서버에서 한 번 더 막는다.
// 규칙에는 반복문이 없어 목록 안 항목별 값과 하루 합계(600분)는 앱에서만 검사한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 날짜 키가 가리키는 날의 한국 시간 0시. 없는 날짜(2월 30일 등)면 오류가 나서 요청이 거절된다.
    function kstDayStart(dateKey) {
      let parts = dateKey.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) - duration.value(9, 'h');
    }

    function notFuture(dateKey) {
      return request.time >= kstDayStart(dateKey);
    }

    // 오늘을 0일로 셌을 때 days일 전까지
    function withinDays(dateKey, days) {
      return request.time < kstDayStart(dateKey) + duration.value(days + 1, 'd');
    }

    function isTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isCount(value, max) {
      return value is int && value >= 0 && value <= max;
    }

    // 스마트폰 종류별 분: 정해진 7가지만, 각각 0~1440
    function isValidCategories(c) {
      return c is map
        && c.keys().hasOnly(['sns', 'video', 'game', 'study', 'creative', 'shopping', 'other'])
        && isCount(c.get('sns', 0), 1440) && isCount(c.get('video', 0), 1440)
        && isCount(c.get('game', 0), 1440) && isCount(c.get('study', 0), 1440)
        && isCount(c.get('creative', 0), 1440) && isCount(c.get('shopping', 0), 1440)
        && isCount(c.get('other', 0), 1440);
    }

    // 스마트폰 사용(src/records/record.js validatePhone과 같은 범위). 앱 목록은 3개까지(항목 값은 앱에서 검사)
    function isValidPhone(p) {
      return p is map
        && p.keys().hasAll(['total', 'categories', 'pickups', 'notifications'])
        && p.keys().hasOnly(['total', 'categories', 'topApps', 'pickups', 'firstPickup', 'pickupApps', 'notifications', 'notifyApps'])
        && isCount(p.total, 1440)
        && isValidCategories(p.categories)
        && isCount(p.pickups, 1000)
        && isCount(p.notifications, 3000)
        && (p.get('firstPickup', null) == null || isTime(p.firstPickup))
        && p.get('topApps', []) is list && p.get('topApps', []).size() <= 3
        && p.get('pickupApps', []) is list && p.get('pickupApps', []).size() <= 3
        && p.get('notifyApps', []) is list && p.get('notifyApps', []).size() <= 3;
    }

    function isValidRecord(dateKey) {
      let data = request.resource.data;
      let fields = ['date', 'sleep', 'workouts', 'studies', 'meals', 'mood', 'customHabits', 'updatedAt'];
      // 스마트폰 사용·걸음 수는 나중에 더한 필드라 없어도 된다(예전 기록 호환).
      let optional = ['phone', 'steps'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(optional))
        && (data.get('phone', null) == null || isValidPhone(data.phone))
        && (data.get('steps', null) == null || isCount(data.steps, 100000))
        && data.date == dateKey
        && data.sleep is map
        && data.sleep.keys().hasOnly(['bedTime', 'wakeTime'])
        && isTime(data.sleep.bedTime) && isTime(data.sleep.wakeTime)
        && data.workouts is list && data.workouts.size() <= 10
        && data.studies is list && data.studies.size() <= 10
        && data.meals is map
        && data.meals.keys().hasOnly(['count', 'lateSnack'])
        && data.meals.count is int && data.meals.count >= 0 && data.meals.count <= 5
        && data.meals.lateSnack is bool
        && data.mood is int && data.mood >= 1 && data.mood <= 5
        && data.customHabits is list && data.customHabits.size() <= 5
        && data.updatedAt == request.time;
    }

    match /users/{uid}/records/{dateKey} {
      allow read: if signedInAs(uid);

      // 새 기록은 오늘·어제만
      allow create: if signedInAs(uid)
        && isDateKey(dateKey)
        && isValidRecord(dateKey)
        && notFuture(dateKey)
        && withinDays(dateKey, 1);

      // 수정·삭제는 7일 이내만
      allow update: if signedInAs(uid)
        && isValidRecord(dateKey)
        && notFuture(dateKey)
        && withinDays(dateKey, 7);

      allow delete: if signedInAs(uid)
        && isDateKey(dateKey)
        && withinDays(dateKey, 7);
    }

    // 위에서 허용하지 않은 경로는 모두 거절한다.
  }
}
